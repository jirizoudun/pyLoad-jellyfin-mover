[Unit]
Description=Rebuild pyLoad Jellyfin Mover on self-update request

[Service]
Type=oneshot
# Edit these paths if your repo does not live in /opt/pyLoad-jellyfin-mover.
WorkingDirectory=/opt/pyLoad-jellyfin-mover
ExecStart=/opt/pyLoad-jellyfin-mover/update-watcher.sh

# Runs as root by default, which can drive docker and remove the (root-owned)
# flag file the container writes. If you run docker as a non-root user, set
# User=/Group= to that account and make sure it can run docker + git here.
# User=youruser
# Group=youruser
